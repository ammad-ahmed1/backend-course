<h1>My Cart</h1>

{{#if products.length}}
  <div class="cart-container">
    <table class="cart-table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Price</th>
          <th>Quantity</th>
          <th>Total</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {{#each products}}
          <tr>
            <!-- Product -->
            <td class="product-info">
              <img
                src="{{this.productId.imageUrl}}"
                alt="{{this.productId.title}}"
              />
              <span>{{this.productId.title}}</span>
            </td>

            <!-- Price -->
            <td>${{this.productId.price}}</td>

            <!-- Quantity -->
            <td>
              <input
                type="number"
                min="1"
                value="{{this.quantity}}"
                class="quantity-input"
              />
            </td>

            <!-- Total -->
            <td>${{multiply this.productId.price this.quantity}}</td>

            <!-- Action -->
            <td>
              <form action="/shop/cart-delete-item" method="POST">
                <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                <input
                  type="hidden"
                  name="productId"
                  value="{{this.productId._id}}"
                />
                <button type="submit" class="btn-remove">Remove</button>
              </form>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="cart-summary">
      <p><strong>Subtotal:</strong> ${{cartTotal}}</p>
      <form action="/shop/create-order" method="POST">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <button type="submit" class="btn-checkout">Proceed to Checkout</button>
      </form>
    </div>
  </div>
{{else}}
  <p>Your cart is empty.</p>
{{/if}}