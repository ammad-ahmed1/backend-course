<h1>My Cart</h1>

{{#if cartItems.length}}
  <div class="cart-container">
    <table class="cart-table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Price</th>
          <th>Quantity</th>
          <th>Total</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {{#each cartItems}}
          <tr>
            <td class="product-info">
              <img src="{{this.image}}" alt="{{this.title}}" />
              <span>{{this.title}}</span>
            </td>
            <td>${{this.price}}</td>
            <td>
              <input
                type="number"
                min="1"
                value="{{this.quantity}}"
                class="quantity-input"
              />
            </td>
            <td>${{multiply this.price this.quantity}}</td>
            <td>
              <form action="/shop/cart-delete-item" method="POST">
                <input type="hidden" name="productId" value="{{this.id}}" />
                <button type="submit" class="btn-remove">Remove</button>
              </form>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="cart-summary">
      <p><strong>Subtotal:</strong> ${{cartTotal}}</p>
      <button class="btn-checkout">Proceed to Checkout</button>
    </div>
  </div>
{{else}}
  <p>Your cart is empty.</p>
{{/if}}