<h1 class="cart-heading">🛒 My Cart</h1>

{{#if products.length}}
  <div class="cart-container">
    <table class="cart-table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Price</th>
          <th>Quantity</th>
          <th>Total</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {{#each products}}
          <tr class="cart-row">
            <!-- Product -->
            <td class="product-info">
              <img
                src="{{this.productId.imageUrl}}"
                alt="{{this.productId.title}}"
                class="product-img"
              />
              <span class="product-title">{{this.productId.title}}</span>
            </td>

            <!-- Price -->
            <td class="product-price">${{this.productId.price}}</td>

            <!-- Quantity -->
            <td class="product-qty">
              <form action="/shop/cart-update-item" method="POST" class="qty-form">
                <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                <input type="hidden" name="productId" value="{{this.productId._id}}" />
                <input
                  type="number"
                  name="quantity"
                  min="1"
                  value="{{this.quantity}}"
                  class="quantity-input"
                  onchange="this.form.submit()"
                />
              </form>
            </td>

            <!-- Total -->
            <td class="product-total">
              ${{multiply this.productId.price this.quantity}}
            </td>

            <!-- Action -->
            <td class="product-action">
              <form action="/shop/cart-delete-item" method="POST">
                <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                <input type="hidden" name="productId" value="{{this.productId._id}}" />
                <button type="submit" class="btn-remove">✕</button>
              </form>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>

    <!-- Cart Summary -->
    <div class="cart-summary">
      <p><strong>Subtotal:</strong> ${{cartTotal}}</p>
      {{!-- <form action="/shop/create-order" method="POST">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <button
          type="submit"
          class="btn-checkout"
          {{#unless products.length}}disabled{{/unless}}
        >
          Proceed to Checkout →
        </button>
      </form> --}}
       <a
          href="/shop/checkout"
          class="btn-checkout"
        >
          Proceed to Checkout →
        </a>
    </div>
  </div>
{{else}}
  <p class="cart-empty">🛍️ Your cart is empty. <a href="/shop">Continue shopping</a></p>
{{/if}}
