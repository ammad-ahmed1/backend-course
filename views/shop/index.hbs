<h1>Shop Products</h1>

{{#if prods.length}}
  <div class="product-grid">
    {{#each prods}}
      <div class="product-card">
        <img src={{this.imageUrl}} alt="{{this.title}}" />
        <h2>{{this.title}}</h2>
        <p class="price">{{this.price}}</p>

      </div>
    {{/each}}
  </div>
{{else}}
  <p>No products available yet.</p>
{{/if}}