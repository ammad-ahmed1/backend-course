<h1>Shop Products</h1>

{{#if prods}}
  <div class="product-grid">
    {{#each prods}}
      <div class="product-card">
        <img src="/{{this.imageUrl}}" alt="{{this.title}}" />
        <h2>{{this.title}}</h2>
        <p class="price">$ {{this.price}}</p>

        <div class="product-actions">
          <a href="/shop/products/{{this._id}}" class="btn-details">
            🔍 View Details
          </a>
          {{#if ../isAuthenticated}}
            {{> add-to-cart product=this csrfToken=../csrfToken}}
          {{/if}}
        </div>
      </div>
    {{/each}}
  </div>

  <!-- Pagination Section -->
  {{> pagination 
      page=page 
      previousPage=previousPage 
      nextPage=nextPage 
      hasPreviousPage=hasPreviousPage 
      hasNextPage=hasNextPage 
      lastPage=lastPage
      baseUrl="/shop/products"

  }}

{{else}}
  <p>No products available yet.</p>
{{/if}}
