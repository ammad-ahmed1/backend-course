<h1 class="checkout-title">Checkout</h1>

<div class="checkout-container">
  <!-- Cart Summary -->
  <div class="cart-summary">
    <h2>Your Cart</h2>
    {{#if products}}
      <ul class="cart-list">
        {{#each products}}
          <li class="cart-item">
            <div class="cart-item-info">
              <img
                src="/{{this.productId.imageUrl}}"
                alt="{{this.productId.title}}"
              />
              <div>
                <h3>{{this.productId.title}}</h3>
                <p>Quantity: {{this.quantity}}</p>
                <p class="price">$ {{this.productId.price}}</p>
              </div>
            </div>
            <div class="item-total">
              $
              {{multiply this.quantity this.productId.price}}
            </div>
          </li>
        {{/each}}
      </ul>

      <div class="cart-total">
        <strong>Total: </strong>
        <span class="total-price">$ {{totalPrice}}</span>
      </div>
    {{else}}
      <p>Your cart is empty.</p>
    {{/if}}
  </div>

  <!-- Payment Section -->
  <div class="payment-form">
    <h2>Billing Details</h2>
    <form action="/create-order" method="POST">
      <div class="form-group">
        <label for="name">Full Name</label>
        <input
          id="name"
          name="name"
          type="text"
          placeholder="John Doe"
          required
        />
      </div>

      <div class="form-group">
        <label for="address">Address</label>
        <input
          id="address"
          name="address"
          type="text"
          placeholder="123 Street, City"
          required
        />
      </div>

      <div class="form-group">
        <label for="card">Card Number</label>
        <input
          id="card"
          name="card"
          type="text"
          placeholder="**** **** **** 1234"
          required
        />
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="expiry">Expiry</label>
          <input
            id="expiry"
            name="expiry"
            type="text"
            placeholder="MM/YY"
            required
          />
        </div>
        <div class="form-group">
          <label for="cvc">CVC</label>
          <input id="cvc" name="cvc" type="text" placeholder="123" required />
        </div>
      </div>

      <button type="submit" class="checkout-btn">Place Order</button>
      <script src="https://js.stripe.com/v3/">
      </script>
      <script>
        var stripe = Stripe()
      </script>
    </form>
  </div>
</div>