<h1>Checkout</h1>

<div class="checkout-container">

  <!-- Shipping Details -->
  <div class="checkout-section shipping-details">
    <h2>Shipping Details</h2>
    <form action="/place-order" method="POST" class="form">
      <div class="form-group">
        <label for="fullname">Full Name</label>
        <input
          type="text"
          id="fullname"
          name="fullname"
          placeholder="John Doe"
          required
        />
      </div>

      <div class="form-group">
        <label for="email">Email Address</label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder="example@mail.com"
          required
        />
      </div>

      <div class="form-group">
        <label for="address">Address</label>
        <input
          type="text"
          id="address"
          name="address"
          placeholder="123 Main St, City"
          required
        />
      </div>

      <div class="form-group">
        <label for="zipcode">ZIP Code</label>
        <input
          type="text"
          id="zipcode"
          name="zipcode"
          placeholder="12345"
          required
        />
      </div>

      <div class="form-group">
        <label for="phone">Phone Number</label>
        <input
          type="text"
          id="phone"
          name="phone"
          placeholder="+1 234 567 890"
          required
        />
      </div>
    </form>
  </div>

  <!-- Order Summary -->
  <div class="checkout-section order-summary">
    <h2>Order Summary</h2>
    <div class="summary-items">
      {{#each cartItems}}
        <div class="summary-item">
          <span>{{this.title}} (x{{this.quantity}})</span>
          <span>${{multiply this.price this.quantity}}</span>
        </div>
      {{/each}}
    </div>

    <div class="summary-total">
      <strong>Total:</strong>
      <span>${{cartTotal}}</span>
    </div>

    <!-- Payment Section -->
    <div class="payment-method">
      <h3>Payment Method</h3>
      <label><input type="radio" name="payment" value="cod" checked />
        Cash on Delivery</label>
      <label><input type="radio" name="payment" value="card" />
        Credit/Debit Card</label>
    </div>

    <button type="submit" form="checkout-form" class="btn-place-order">Place
      Order</button>
  </div>

</div>