<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Payment Successful</title>
    <link rel="stylesheet" href="/css/checkout.css" />
    <style>
      body { font-family: 'Lato', sans-serif; background: #f6fff8; display:
