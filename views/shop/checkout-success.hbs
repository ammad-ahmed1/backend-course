      inline-block; padding: 10px 20px; background: #28a745; color: #fff;
      border-radius: 8px; text-decoration: none; font-weight: bold; transition:
      background 0.2s; } a:hover { background: #218838; }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="icon">✅</div>
