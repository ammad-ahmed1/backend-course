<h1>My Orders</h1>

{{#if orders.length}}
  <div class="orders-container">
    <table class="orders-table">
      <thead>
        <tr>
          <th>Order ID</th>
          <th>Product(s)</th>
          <th>Quantity</th>
          <th>Price</th>
          <th>User</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each orders}}
          {{#each this.products}}
            <tr>
              <td>{{../_id}}</td>
              <td>{{product.title}}</td>
              <td>{{quantity}}</td>
              <td>$ {{product.price}}</td>
              <td>{{../user.name}} <br /> <small>{{../user.email}}</small></td>
              <td>
                <a href="/shop/orders/{{../_id}}" class="btn-view">Invoice</a>
              </td>
            </tr>
          {{/each}}
        {{/each}}
      </tbody>
    </table>

    <!-- Pagination Section -->
    {{> pagination 
        page=page 
        previousPage=previousPage 
        nextPage=nextPage 
        hasPreviousPage=hasPreviousPage 
        hasNextPage=hasNextPage 
        lastPage=lastPage
        baseUrl="/shop/orders"

    }}
  </div>
{{else}}
  <p style="text-align:center; margin-top:20px;">No orders have been placed yet.</p>
{{/if}}
