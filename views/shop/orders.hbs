<h1>My Orders</h1>

{{#if orders.length}}
  <div class="orders-container">
    <table class="orders-table">
      <thead>
        <tr>
          <th>Order ID</th>
          <th>Product(s)</th>
          <th>Quantity</th>
          <th>Price</th>
          <th>User</th>
        </tr>
      </thead>
      <tbody>
        {{#each orders}}
          {{#each this.products}}
            <tr>
              <td>{{../_id}}</td>
              <td>{{product.title}}</td>
              <td>{{quantity}}</td>
              <td>${{product.price}}</td>
              <td>{{../user.name}} ({{../user.email}})</td>
            </tr>
          {{/each}}
        {{/each}}
      </tbody>
    </table>
  </div>
{{else}}
  <p>No orders have been placed yet.</p>
{{/if}}
