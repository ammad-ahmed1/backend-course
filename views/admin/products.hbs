<h1>My Products</h1>

{{#if prods.length}}
  <div class="product-grid">
    {{#each prods}}
      <div class="product-card">
        <img src={{this.imageUrl}} alt="{{this.title}}" />
        <h2>{{this.title}}</h2>
        <p class="price">{{this.price}}</p>
        <div class="product-actions">
          <a href="/admin/edit-product/{{this.id}}" class="btn-edit">✏️ Edit</a>
          <a href="/admin/delete-product/{{this.id}}" class="btn-delete">🗑️
            Delete</a>
        </div>
      </div>
    {{/each}}
  </div>
{{else}}
  <p>No products available yet.</p>
{{/if}}